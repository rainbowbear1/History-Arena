{
  "name": "history-arena-firebase-tests",
  "private": true,
  "type": "module",
  "description": "Security-rule tests for firestore.rules, run against the Firebase Emulator Suite.",
  "scripts": {
    "test": "firebase emulators:exec --project demo-history-arena --only firestore,auth --config ../../firebase.json \"node --test rules.test.mjs\"",
    "emulators": "firebase emulators:start --project demo-history-arena --only firestore,auth --config ../../firebase.json"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1"
  }
}
