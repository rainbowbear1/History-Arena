rules_version = '2';

// History Arena: who may read and write the leaderboard (deployed to Cloud Firestore).
//
//   players/{uid}                 one row per Google account: name, best score s1..s10 and stars
//                                 t1..t10 per level, total = s1 + ... + s10, last attempt id
//   players/{uid}/attempts/{id}   every finished run, write-once (campaign levels 1-10, BOSS 11,
//                                 All-in-One 12)
//   achievements/{uid}            BOSS victory (permanent), best BOSS score and highest trophy
//   allinone/{uid}                All-in-One personal best (own leaderboard, never in the total)
//   admins/{uid}                  teacher accounts, created only in the Firebase Console
//
// The uid always comes from the verified Firebase ID token (request.auth), never from the game.
// Scores are still produced in the player's browser; see docs/online.md for what these rules
// cannot prevent.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Tasks per level x 100 (questions/*.json). tests/run_tests.gd checks that these match.
    function maxScore(level) {
      return {'1': 1300, '2': 1300, '3': 1400, '4': 1400, '5': 1300,
              '6': 1300, '7': 1200, '8': 1300, '9': 1300, '10': 1500}[string(level)];
    }

    // All-in-One asks every campaign task once: its maximum is the sum of the level maxima above
    // (written out, as rules evaluation is limited; tests/run_tests.gd checks the sum).
    function poolMax() {
      return 13300;
    }

    // The BOSS asks 50 tasks (data/levels.json "boss": "questions").
    function bossTasks() {
      return 50;
    }

    function maxScoreOf(level) {
      return level == 12 ? poolMax() : level == 11 ? bossTasks() * 100 : maxScore(level);
    }

    // BOSS trophies by the share of correct answers: 1 bronze from 60 %, 2 silver from 75 %, 3 gold
    // from 90 % (ProgressStore.trophy_for). Below 60 % the BOSS is not defeated.
    function trophyFor(correct) {
      return correct * 100 >= 90 * bossTasks() ? 3
           : correct * 100 >= 75 * bossTasks() ? 2
           : correct * 100 >= 60 * bossTasks() ? 1 : 0;
    }

    // The "double score" ability can add at most this much per run (2 uses x 100).
    function doubleBonus() {
      return 200;
    }

    function playerName() {
      return request.auth.token.get('name', 'Ойыншы');
    }

    function validAttempt(a) {
      return a.keys().hasOnly(['level', 'character', 'score', 'max_score', 'correct', 'wrong',
                               'playtime_sec', 'stars', 'passed', 'completed', 'revivals_used',
                               'finished_at', 'game_id', 'client_version', 'created', 'answered'])
          && a.keys().hasAll(['level', 'score', 'max_score', 'stars', 'playtime_sec', 'created'])
          && a.level is int && a.level >= 1 && a.level <= 12
          && a.max_score == maxScoreOf(a.level)
          && (a.level != 11 || validBossRun(a))
          && (a.level != 12 || validPoolRun(a))
          && a.score is int && a.score >= 0 && a.score % 100 == 0
          && a.score <= a.max_score + doubleBonus()
          && a.stars is int && a.stars >= 0 && a.stars <= 3
          && a.playtime_sec is int && a.playtime_sec <= 86400
          && a.playtime_sec >= a.score / 100          // at least a second per solved task
          && a.get('correct', 0) is int && a.get('correct', 0) >= 0 && a.get('correct', 0) <= 200
          && a.get('wrong', 0) is int && a.get('wrong', 0) >= 0 && a.get('wrong', 0) <= 200
          && a.get('revivals_used', 0) is int && a.get('revivals_used', 0) >= 0 && a.get('revivals_used', 0) <= 5
          && a.get('passed', false) is bool && a.get('passed', false) == (a.stars > 0)
          && a.get('completed', false) is bool
          && a.get('character', '') is string && a.get('character', '').size() <= 32
          && a.get('finished_at', 0) is int
          && a.get('game_id', 'history-arena') == 'history-arena'
          && a.get('client_version', '') is string && a.get('client_version', '').size() <= 16
          && a.created == request.time;
    }

    // A BOSS run: its "stars" are the trophy earned by its correct answers (none for an unfinished
    // run); every point needs a correct task (plus the double-score bonus).
    function validBossRun(a) {
      return a.keys().hasAll(['correct', 'completed'])
          && a.correct <= bossTasks()
          && a.score >= a.correct * 100 && a.score <= a.correct * 100 + doubleBonus()
          && a.stars == (a.completed ? trophyFor(a.correct) : 0);
    }

    // An All-in-One run is counted in tasks: answered of the pool, correct of answered, wrong = the
    // rest; every point needs a correct task (plus the double-score bonus); no stars; a completed
    // run answered the whole pool.
    function validPoolRun(a) {
      return a.keys().hasAll(['correct', 'wrong', 'answered', 'completed'])
          && a.answered is int && a.answered >= a.correct && a.answered * 100 <= poolMax()
          && a.wrong == a.answered - a.correct
          && a.score >= a.correct * 100 && a.score <= a.correct * 100 + doubleBonus()
          && a.stars == 0
          && (!a.completed || a.answered * 100 == poolMax());
    }

    // The All-in-One best copies its run (created in the same write) and its ranking key: correct
    // answers, then accuracy per thousand (acc = floor(1000 * correct / answered)), then the
    // shorter active time. It is only ever replaced by a better run.
    function validPoolBest(uid, prev) {
      let d = request.resource.data;
      let run = /databases/$(database)/documents/players/$(uid)/attempts/$(d.run);
      let a = getAfter(run).data;
      return d.keys().hasOnly(['name', 'correct', 'answered', 'wrong', 'acc', 'time', 'score', 'completed',
                               'pool', 'key', 'run', 'updated'])
          && d.run is string && !exists(run) && existsAfter(run)
          && a.level == 12
          && d.name == playerName()
          && d.updated == request.time
          && d.correct == a.correct && d.answered == a.answered && d.wrong == a.wrong
          && d.score == a.score && d.time == a.playtime_sec && d.completed == a.completed
          && d.pool * 100 == poolMax()
          && d.acc is int
          && ((d.answered == 0 && d.acc == 0)
              || (d.answered > 0 && d.acc * d.answered <= d.correct * 1000 && d.correct * 1000 < (d.acc + 1) * d.answered))
          && d.key == d.correct * 100000000 + d.acc * 100000 + (99999 - d.time)
          && d.key > prev.get('key', -1);
    }

    // Level j is unchanged unless it is the level k of this write's attempt.
    function same(d, prev, k, j) {
      return j == k || (d['s' + j] == prev.get('s' + j, 0) && d['t' + j] == prev.get('t' + j, 0));
    }

    // A best value can only rise, and only to the new attempt's value.
    function best(d, prev, field, value) {
      let old = prev.get(field, 0);
      return (value > old && d[field] == value) || (value <= old && d[field] == old);
    }

    // Every player write must come with a new attempt created in the same transaction, and may
    // only raise that attempt's level.
    function validPlayer(uid, prev) {
      let d = request.resource.data;
      let attempt = /databases/$(database)/documents/players/$(uid)/attempts/$(d.last);
      let a = getAfter(attempt).data;
      let k = string(a.level);
      return d.keys().hasOnly(['name', 'last', 'updated', 'total',
                               's1', 's2', 's3', 's4', 's5', 's6', 's7', 's8', 's9', 's10',
                               't1', 't2', 't3', 't4', 't5', 't6', 't7', 't8', 't9', 't10'])
          && d.last is string
          && !exists(attempt) && existsAfter(attempt)
          && d.name == playerName()
          && d.updated == request.time
          && same(d, prev, k, '1') && same(d, prev, k, '2') && same(d, prev, k, '3')
          && same(d, prev, k, '4') && same(d, prev, k, '5') && same(d, prev, k, '6')
          && same(d, prev, k, '7') && same(d, prev, k, '8') && same(d, prev, k, '9')
          && same(d, prev, k, '10')
          && best(d, prev, 's' + k, a.score) && best(d, prev, 't' + k, a.stars)
          && d.total == d.s1 + d.s2 + d.s3 + d.s4 + d.s5 + d.s6 + d.s7 + d.s8 + d.s9 + d.s10;
    }

    // Permanent achievements: defeating the BOSS (a 50-task run, max 5000 + double-score bonus).
    // Once true it stays true; the best BOSS score, the trophy and the best correct count can only
    // rise; the first victory time is fixed.
    //  - With a run (the normal case): a winning BOSS attempt created in the same write; the trophy
    //    and correct count are raised to that run's, never beyond.
    //  - Without a run: a victory queued by a build from before trophies (only its score is known);
    //    it may raise the best score but leaves the trophy and correct count as they are, so no
    //    trophy is ever granted without a run that earned it.
    function validAchievement(uid, prev) {
      let d = request.resource.data;
      return d.keys().hasOnly(['bossDefeated', 'bossBest', 'trophy', 'bestCorrect', 'firstDefeated', 'updated', 'run'])
          && d.bossDefeated == true
          && d.bossBest is int && d.bossBest % 100 == 0
          && d.bossBest >= prev.get('bossBest', 0) && d.bossBest <= bossTasks() * 100 + doubleBonus()
          && d.get('trophy', 0) is int && d.get('bestCorrect', 0) is int
          && d.updated == request.time
          && d.firstDefeated == prev.get('firstDefeated', request.time)
          && (d.keys().hasAny(['run']) ? achievementRun(uid, d, prev) : achievementKept(d, prev));
    }

    function achievementRun(uid, d, prev) {
      let run = /databases/$(database)/documents/players/$(uid)/attempts/$(d.run);
      let a = getAfter(run).data;
      return d.run is string && !exists(run) && existsAfter(run)
          && a.level == 11 && a.stars > 0
          && best(d, prev, 'bossBest', a.score)
          && best(d, prev, 'trophy', a.stars)
          && best(d, prev, 'bestCorrect', a.correct);
    }

    function achievementKept(d, prev) {
      return d.get('trophy', 0) == prev.get('trophy', 0) && d.get('bestCorrect', 0) == prev.get('bestCorrect', 0);
    }

    match /achievements/{uid} {
      // Trophies are shown beside names on the leaderboards, so signed-in players can read them.
      allow read: if signedIn();
      allow create: if isOwner(uid) && validAchievement(uid, {});
      allow update: if isOwner(uid) && validAchievement(uid, resource.data);
      allow delete: if false;
    }

    // Administrators (teachers): one document per uid, created only by the project owner in the
    // Firebase Console. Clients may only check whether their own document exists.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /allinone/{uid} {
      // The All-in-One leaderboard, like the campaign one, is visible to signed-in players.
      allow read: if signedIn();
      allow create: if isOwner(uid) && validPoolBest(uid, {});
      allow update: if isOwner(uid) && validPoolBest(uid, resource.data);
      allow delete: if false;
    }

    match /players/{uid} {
      // Signed-in players can see the leaderboard (names and scores only; no e-mail is stored).
      allow read: if signedIn();
      allow create: if isOwner(uid) && validPlayer(uid, {});
      // At most one result every 5 seconds per player.
      allow update: if isOwner(uid) && validPlayer(uid, resource.data)
                    && request.time > resource.data.updated + duration.value(5, 's');
      allow delete: if false;

      match /attempts/{attemptId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validAttempt(request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
